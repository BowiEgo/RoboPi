{
	"name": "robopi",
	"version": "1.0.0",
	"description": "An Electron application with Solid and TypeScript",
	"main": "./out/main/index.js",
	"author": "example.com",
	"homepage": "https://electron-vite.org",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"format": "biome format --write ./src",
		"lint": "biome lint ./src",
		"check": "biome check --write ./src",
		"ci": "biome ci ./src",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build && npm run build:agent-host",
		"build:agent-host": "node scripts/build-agent-host.mjs",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "npm run build && electron-builder --mac",
		"build:linux": "npm run build && electron-builder --linux"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/orbitron": "^5.3.0",
		"@solid-primitives/i18n": "^2.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electron-updater": "^6.3.9",
		"lucide-solid": "^1.28.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@solidjs/testing-library": "^0.8.10",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.19.1",
		"daisyui": "^5.7.14",
		"electron": "^39.2.6",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"jsdom": "^29.1.1",
		"solid-js": "^1.9.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-solid": "^2.11.10",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	}
}
