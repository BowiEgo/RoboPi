{
	"extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
	"include": [
		"electron.vite.config.*",
		"src/main/**/*",
		"src/preload/**/*",
		"src/backend/agent/**/*",
		"src/shared/**/*"
	],
	"compilerOptions": {
		"composite": true,
		"types": ["electron-vite/node"],
		"allowImportingTsExtensions": true
	}
}
